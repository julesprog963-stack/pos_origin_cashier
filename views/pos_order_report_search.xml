<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_origin_cashier_report_pos_order_search" model="ir.ui.view">
        <field name="name">report.pos.order.search.origin.cashier</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="pos_hr.view_report_pos_order_search_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='employee_id']" position="after">
                <filter string="Cashier origen" name="origin_cashier_id" domain="[]" context="{'group_by': 'origin_cashier_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="pos_origin_cashier_report_pos_order_tree" model="ir.ui.view">
        <field name="name">report.pos.order.view.tree.origin.cashier</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="pos_hr.report_pos_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="origin_cashier_id" widget="many2one_avatar_employee"/>
            </xpath>
        </field>
    </record>
</odoo>
